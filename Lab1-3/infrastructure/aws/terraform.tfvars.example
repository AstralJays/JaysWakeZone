# Labs 1–3 only. Separate state from Lab4/ and Lab5/.
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init && terraform apply && terraform output

aws_region = "us-east-1"
# aws_profile = "surfshop"

name_prefix    = "jayswakezone"
instance_type  = "t3.large"
root_volume_gb = 40

# Host access for Upwind sensor install:
# Default = SSM (aws ssm start-session) — no key required.
# For OpenSSH / PuTTY instead (or in addition), set an existing EC2 key pair name:
# key_name = "my-ec2-keypair"
# Then: ssh -i key.pem ubuntu@<lab2_public_ip>  (PuTTY: convert .pem → .ppk)

repo_url = "https://github.com/AstralJays/JaysWakeZone.git"
repo_ref = "main"

# Do NOT put Upwind credentials here - install sensors yourself after apply.
