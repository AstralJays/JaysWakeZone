# Labs 1–3 only. Separate state from Lab4/ and Lab5/.

location    = "eastus"
name_prefix = "jayswakezone"

admin_username = "azureuser"
# Required for SSH / PuTTY into the Lab 2 VM (Upwind host sensor).
#   ssh-keygen -t ed25519 -f ~/.ssh/jwz_lab -N "" -C "jayswakezone"
#   cat ~/.ssh/jwz_lab.pub
# ssh_public_key = "ssh-ed25519 AAAA..."
# Then: ssh -i ~/.ssh/jwz_lab azureuser@<lab2_public_ip>
# PuTTY: import private key in PuTTYgen → save .ppk → user azureuser

repo_url = "https://github.com/AstralJays/JaysWakeZone.git"
repo_ref = "main"
