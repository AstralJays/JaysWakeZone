# Labs 1–3 only. Independent of ../lab4-containers and ../lab5-kubernetes.
#   cp terraform.tfvars.example terraform.tfvars
#   terraform init && terraform apply && terraform output

aws_region = "us-east-1"
# aws_profile = "surfshop"

name_prefix    = "jayswakezone"
instance_type  = "t3.large"
root_volume_gb = 40

# Host access for Upwind sensor install:
# Default = SSM (no key). Optional SSH:
# key_name = "my-ec2-keypair"

repo_url = "https://github.com/AstralJays/JaysWakeZone.git"
repo_ref = "main"

# Do NOT put Upwind credentials here - install sensors yourself after apply.
