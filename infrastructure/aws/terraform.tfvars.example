aws_region   = "us-east-1"
# aws_profile = "surfshop"   # optional — omit to use default credential chain

name_prefix = "jayswakezone"

# One apply = Lab 1 (buckets) + Lab 2 (VM) + Lab 4 (Lambda). K8s later.
enable_lab1 = true
enable_lab2 = true
enable_lab4 = true
enable_lab3 = false

# Lab 2 VM — sized so the SA can install a host sensor themselves
instance_type  = "t3.large"
root_volume_gb = 40

ssh_ingress_cidr = "0.0.0.0/0"
app_ingress_cidr = "0.0.0.0/0"

repo_url = "https://github.com/AstralJays/JaysWakeZone.git"
repo_ref = "main"

# Do NOT put Upwind credentials here — SAs install/connect Upwind themselves.
