aws_region   = "us-east-1"
# aws_profile = "surfshop"   # optional — omit to use default credential chain

name_prefix = "jayswakezone"
enable_lab1 = true
enable_lab2 = true

# Lab 2 VM sizing — scanner-v2 needs ~7 GiB free if installing Upwind sensor
instance_type  = "t3.large"
root_volume_gb = 40

ssh_ingress_cidr = "0.0.0.0/0"
app_ingress_cidr = "0.0.0.0/0"

repo_url = "https://github.com/AstralJays/JaysWakeZone.git"
repo_ref = "main"

# Optional — leave empty to skip sensor
upwind_client_id          = ""
upwind_client_secret      = ""
upwind_agent_extra_config = "scanner-v2=true,inuse-python=true,inuse-skip-young-process=false"
