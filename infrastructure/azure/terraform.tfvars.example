# Grab and go — copy to terraform.tfvars, then:
#   terraform init && terraform apply && terraform output

location    = "eastus"
name_prefix = "jayswakezone"

# Onboarding day only (cost-minded)
enable_lab1 = true   # storage
enable_lab2 = true   # VM and Hosts
enable_lab3 = true   # App Service
enable_lab4 = false  # Azure Container Apps — later
enable_lab5 = false  # AKS — last

admin_username = "azureuser"
# Required:
# ssh_public_key = "ssh-rsa AAAA..."

repo_url = "https://github.com/AstralJays/JaysWakeZone.git"
repo_ref = "main"

# Do NOT put Upwind credentials here — install sensors yourself after apply.
