location    = "eastus"
name_prefix = "jayswakezone"

# One apply = Lab 1 (stores) + Lab 2 (VM) + Lab 4 (App Service). K8s later.
enable_lab1 = true
enable_lab2 = true
enable_lab4 = true
enable_lab3 = false

# Public Docker Hub — no ACR / no Actions.
# serverless_image = "python:3.9-bullseye"

admin_username = "azureuser"
# Required for Lab 2:
# ssh_public_key = "ssh-rsa AAAA..."

repo_url = "https://github.com/AstralJays/JaysWakeZone.git"
repo_ref = "main"

# Do NOT put Upwind credentials here — SAs install/connect Upwind themselves.
