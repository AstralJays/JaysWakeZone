project_id  = "YOUR_GCP_PROJECT"
region      = "us-central1"
zone        = "us-central1-a"
name_prefix = "jayswakezone"

# One apply = Lab 1 (two buckets) + Lab 2 (VM/app). Leave both true for onboarding day.
enable_lab1 = true
enable_lab2 = true
enable_lab3 = false
enable_lab4 = false

repo_url = "https://github.com/AstralJays/JaysWakeZone.git"
repo_ref = "main"

# Do NOT put Upwind credentials here — SAs install/connect Upwind themselves.
