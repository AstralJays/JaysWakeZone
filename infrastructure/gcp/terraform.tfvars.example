project_id  = "YOUR_GCP_PROJECT"
region      = "us-central1"
zone        = "us-central1-a"
name_prefix = "jayswakezone"

# One apply = Lab 1 (buckets) + Lab 2 (VM) + Lab 4 (Cloud Run). K8s later.
enable_lab1 = true
enable_lab2 = true
enable_lab4 = true
enable_lab3 = false

# Public Docker Hub — no GAR / no Actions.
# serverless_image = "docker.io/library/python:3.9-bullseye"

repo_url = "https://github.com/AstralJays/JaysWakeZone.git"
repo_ref = "main"

# Do NOT put Upwind credentials here — SAs install/connect Upwind themselves.
